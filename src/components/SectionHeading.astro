---
// Rule (PLAN.md): kicker may speak HMI; the h2 states the section's job in
// plain English. A page must be understandable scanning h2s alone.
interface Props {
  kicker: string;
  title: string;
  id?: string;
}
const { kicker, title, id } = Astro.props;
---

<div class="section-heading" id={id}>
  <span class="kicker" aria-hidden="true">{kicker}</span>
  <h2>{title}</h2>
</div>

<style>
  .section-heading { margin-bottom: var(--s-xl); }
</style>
